<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <groupId>innovation-minds</groupId>
  <artifactId>ebeat</artifactId>
  <packaging>jar</packaging>
  <version>1.0</version>
  <name>ebeat-alexa</name>
  <description>ebeat plugin for Alexa</description>

  <dependencies>
    <dependency>
      <groupId>com.amazon.alexa</groupId>
      <artifactId>ask-sdk</artifactId>
      <version>2.16.0</version>
    </dependency>

    <dependency>
      <groupId>com.amazon.alexa</groupId>
      <artifactId>ask-sdk-lambda-support</artifactId>
      <version>2.59.0</version>
    </dependency>

    <!-- Spring 6.1 richiede Java 17+; noi usiamo Java 21 su Lambda. -->
    <!-- RestClient (fluent, thread-safe) sostituisce RestTemplate. -->
    <!-- httpclient Apache rimosso: Spring 6 usa JDK HttpClient nativo. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <version>6.1.14</version>
    </dependency>

    <!-- Jackson esplicito: Spring 6.1 richiede >= 2.14; ask-sdk porta -->
    <!-- una versione più vecchia per via transitiva.                    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.2</version>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>1.7.36</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>lambda/custom</sourceDirectory>
    <resources>
      <resource>
        <directory>lambda/custom/resources</directory>
      </resource>
    </resources>

    <plugins>

      <!-- Compiler: Java 21 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.12.1</version>
        <configuration>
          <source>21</source>
          <target>21</target>
        </configuration>
      </plugin>

      <!-- SHADE: NECESSARIO PER PRODUZIONE DEL JAR CON DIPENDENZE -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>

  </build>

</project>
